{
  "name": "supportdesk-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck:seed",
    "typecheck:seed": "tsc --noEmit prisma/seed.ts --ignoreConfig --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "dotenv": "18.0.9",
    "express": "^5.3.0",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  }
}
