              "path": ["api", "v1", "tickets", "{{customerBTicketId}}", "comments"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 NOT_FOUND\", function () {",
