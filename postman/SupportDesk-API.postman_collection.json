    {
      "name": "3. Ticket Operations & Ownership Isolation",
      "item": [
        {
          "name": "Customer Jane Creates Ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VPN Disconnecting on Wi-Fi\",\n  \"description\": \"Intermittent packet drops when connected to corporate Wi-Fi network.\",\n  \"priority\": \"P2\",\n  \"category\": \"Network\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Ticket created successfully\", function () {",
                  "    pm.expect(json.data.id).to.be.a(\"string\");",
                  "    pm.expect(json.data.status).to.eql(\"OPEN\");",
                  "    pm.expect(json.data.priority).to.eql(\"P2\");",
                  "});",
                  "pm.environment.set(\"ticketId\", json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Customer Bob Creates Ticket (Customer B Ticket)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerBToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bob Confidential Payroll Ticket\",\n  \"description\": \"Financial payroll software sync failure. Confidential compensation data.\",\n  \"priority\": \"P1\",\n  \"category\": \"Finance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.environment.set(\"customerBTicketId\", json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Customer Jane Lists Tickets (Ownership Scoped)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "var bobTicketId = pm.environment.get(\"customerBTicketId\");",
                  "pm.test(\"Customer Jane NEVER sees Customer Bob ticket\", function () {",
                  "    var ticketIds = json.data.map(function(t) { return t.id; });",
                  "    pm.expect(ticketIds).to.not.include(bobTicketId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Customer Jane Gets Own Ticket by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets", "{{ticketId}}"]
