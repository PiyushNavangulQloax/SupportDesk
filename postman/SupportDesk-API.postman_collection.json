          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Returns correct ticket\", function () {",
                  "    pm.expect(json.data.id).to.eql(pm.environment.get(\"ticketId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Customer Jane Updates Own Ticket",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"VPN Disconnecting on Wi-Fi (Updated Details)\",\n  \"description\": \"Drops primarily on 5GHz band; 2.4GHz is stable.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets", "{{ticketId}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Ticket updated\", function () {",
                  "    pm.expect(json.data.title).to.include(\"Updated Details\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "403 Forbidden (Customer Assigning Ticket)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Assignment Attempt\",\n  \"description\": \"Customer trying to set an assigneeId directly.\",\n  \"assigneeId\": \"00000001-0000-0000-0000-000000000005\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Error code is FORBIDDEN\", function () {",
                  "    pm.expect(json.error.code).to.eql(\"FORBIDDEN\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "404 Anti-Enumeration (Jane Accessing Bob's Ticket)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{customerBTicketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets", "{{customerBTicketId}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 NOT_FOUND (Anti-Enumeration)\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Error code is NOT_FOUND\", function () {",
                  "    pm.expect(json.error.code).to.eql(\"NOT_FOUND\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
